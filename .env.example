# ═══════════════════════════════════════════════════════════════
#  CYBER JARVIS v6.0 — Environment Config
#  Copy to .env and fill values
# ═══════════════════════════════════════════════════════════════

# ─── LLM (DeepSeek) ────────────────────────────────────────
DEEPSEEK_API_KEY=Your-api-key
JARVIS_MODEL=deepseek-chat

# ─── Language (english | hinglish | roman_urdu) ────────────
JARVIS_LANGUAGE=hinglish

# ─── Kali VM ───────────────────────────────────────────────
KALI_HOST=192.168.56.101
KALI_SSH_PORT=22
KALI_USER=root
KALI_PASS=kali
KALI_KEY=

# ─── Burp Suite Pro (Windows local) ────────────────────────
BURP_API_URL=http://127.0.0.1:1337
BURP_API_KEY=your-burp-api-key

# ─── Metasploit RPC (REQUIRED — no default!) ───────────────
MSF_RPC_PASSWORD=CHANGE_ME_TO_STRONG_PASSWORD

# ─── NVD API (optional) ────────────────────────────────────
NVD_API_KEY=

# ─── Neo4j (Attack Graph) ──────────────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASS=jarvis_neo4j_pass

# ─── PostgreSQL ────────────────────────────────────────────
POSTGRES_URI=postgresql://jarvis:jarvis_pass@localhost:5432/jarvis

# ─── Redis / Celery ────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── WhatsApp Notifications ────────────────────────────────
WHATSAPP_NUMBER=Your-whatsapp-number
WHATSAPP_METHOD=pywhatkit
# Option B: Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# ─── Wake Word (Porcupine) ─────────────────────────────────
PORCUPINE_ACCESS_KEY=

# ─── Security ──────────────────────────────────────────────
JARVIS_MASTER_KEY=change-this-to-32-byte-random-string